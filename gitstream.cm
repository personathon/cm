
manifest:
  version: 1.0

automations:
  org_performance_ai_review:
    if:
      - {{ pr.target == 'main' }}
      - {{ not pr.draft }}
      - {{ not (is.bot_author or is.bot_branch) }}
    run:
      # First: LinearB AI code review
      - action: code-review@v1
        args:
          approve_on_LGTM: false
          issues_limit: 5
          guidelines: {{ "./performance-review-rules/COMBINED_PERF_RULES.md" | readFile() | dump }}

      # Second: Trigger central k6 workflow after review completes
      - action: run-github-workflow@v1
        args:
          owner: personathon
          repo: cm
          workflow: .github/workflows/perfrun.yml
          ref: main
          inputs:
            source_repo: "{{ repo.owner }}/{{ repo.name }}"
            pr_number: "{{ pr.number }}"

is:
  bot_author: {{ pr.author | match(list=['github-actions', '_bot_', '[bot]', 'dependabot']) | some }}
  bot_branch: {{ branch.name | match(list=['renovate/', 'dependabot/']) | some }}
